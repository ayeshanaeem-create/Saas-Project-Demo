# Copy to .env (non-secret settings, read by Prisma and Next.js)
DATABASE_URL="file:./prisma/dev.db"

# Copy to .env.local (secrets, read by Next.js only).
# Which agent answers customers: "auto" (Claude when ANTHROPIC_API_KEY is set, otherwise
# the free rule-based scripted agent), "scripted", or "claude".
AGENT_MODE="auto"
ANTHROPIC_API_KEY=""
# claude-haiku-5-5: ~0.1–0.2 cents per message, good for demos and development.
# claude-opus-5-5: best replies, ~5 cents per message (the default when unset).
ANTHROPIC_MODEL="claude-haiku-5-5"
# Optional password for a deployed demo (browser sign-in prompt, any username).
# Leave empty locally: everything stays open.
DEMO_PASSWORD=""

# Deploying: the hosted app uses a Turso database instead of the local file. Set these two
# in the host's environment variables, and in .env.turso for `npm run turso:migrate` and
# `npm run turso:seed`, which only ever target the database named in .env.turso.
# DATABASE_URL="libsql://<database>-<org>.turso.io"
# DATABASE_AUTH_TOKEN="<turso db tokens create <database>>"
